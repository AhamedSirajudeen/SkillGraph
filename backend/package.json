{
  "name": "skillgraph-backend",
  "version": "1.0.0",
  "description": "SkillGraph backend - Express + PostgreSQL (Supabase) graph-based learning roadmap API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
